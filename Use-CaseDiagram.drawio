        <mxCell id="hdJ2-effO3fVZHqTzRp7-18" value="&lt;ol&gt;&lt;li&gt;Se l&#39;admin accetta la richiesta l&#39;utente viene registrato nel sistema e gli viene comunicato un username.&lt;/li&gt;&lt;li&gt;Se l&#39;admin non accetta la richiesta viene eliminata dalla base di dati.&lt;/li&gt;&lt;/ol&gt;" style="html=1;align=left;verticalAlign=middle;dashed=0;whiteSpace=wrap;" vertex="1" parent="1">
